{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techguild-shibukawa-2026-team-c",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "team-c",
      "database_id": "4c5c7c8e-ebbd-40db-b47a-b333c6e019b2",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "team-c-images" }],
  // ローカルでは .dev.vars の値で上書きされる
  "vars": {
    "BETTER_AUTH_URL": "https://techguild-shibukawa-2026-team-c.hashimoto-2f0.workers.dev"
  },
  "observability": { "enabled": true }
}
